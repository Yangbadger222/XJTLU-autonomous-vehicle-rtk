{
  "mode_default": "replay",
  "mode_values": ["replay", "shadow", "live"],
  "live_actuator_enabled_by_default": false,
  "tf_owners": {
    "map_to_odom": "rtk_map_odom_corrector (RTK authority only)",
    "odom_to_base_footprint": "Super-LIO vehicle adapter (single owner)",
    "fake_simulator": "replay/sim only; forbidden in live"
  },
  "topics": {
    "/lio/odom": {"type":"nav_msgs/msg/Odometry", "frame":"odom", "child_frame":"base_footprint", "producer":"Super-LIO adapter", "frequency_hz":"PENDING_RUNTIME"},
    "/lio/cloud_body": {"type":"sensor_msgs/msg/PointCloud2", "frame":"base_footprint", "producer":"Super-LIO adapter", "frequency_hz":"PENDING_RUNTIME"},
    "/lio/cloud_world": {"type":"sensor_msgs/msg/PointCloud2", "frame":"odom", "producer":"Super-LIO adapter", "frequency_hz":"PENDING_RUNTIME"},
    "/localization_authority/motion_allowed": {"type":"std_msgs/msg/Bool", "consumer":"safety bridge", "false_policy":"zero command and stop_override"},
    "/research/ego_trajectory": {"type":"research_interfaces/msg/TimedTrajectory2D", "consumer":"research motion tracker", "visual_path_not_control_contract":true},
    "/cmd_vel": {"type":"geometry_msgs/msg/Twist", "producer":"research tracker only in shadow/live", "final_guard":"original authority guard"},
    "/cmd_vel_guarded": {"type":"geometry_msgs/msg/Twist", "producer":"original corridor_cmd_vel_guard", "final_serial_sink":true}
  },
  "serial": {"format":"vcx=<linear.x>,wc=<angular.z * angular_z_scale>\\n", "baud":115200, "scale":1.0, "final_mock_sink_required":true},
  "health_policy": {"super_lio_health_unknown":"motion not allowed", "tf_missing":"stop", "trajectory_expired":"stop", "map_version_mismatch":"stop", "rtk_authority_false":"stop"}
}
