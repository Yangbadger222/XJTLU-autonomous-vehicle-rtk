+    bool PlannerInterface::checkVehicleFeasibility(const UniformBspline& position_traj) const
+    {
+        const auto velocity_traj = position_traj.getDerivative();
+        const auto acceleration_traj = velocity_traj.getDerivative();
+        const double duration = position_traj.getTimeSum();
+        for (double t = 0.0; t <= duration + 1e-6; t += 0.05)
+        {
+            const auto vel = velocity_traj.evaluateDeBoorT(std::min(t, duration));
+            const auto acc = acceleration_traj.evaluateDeBoorT(std::min(t, duration));
+            const double speed = std::hypot(vel(0), vel(1));
+            if (speed < 1e-3)
+                continue;
+            const double yaw_rate = (vel(0) * acc(1) - vel(1) * acc(0)) / speed;
+            const double curvature = yaw_rate / (speed * speed);
+            if (pp_.max_yaw_rate_ > 0.0 && std::abs(yaw_rate) > pp_.max_yaw_rate_ + 1e-6)
+                return false;
+            if (pp_.max_curvature_ > 0.0 && std::abs(curvature) > pp_.max_curvature_ + 1e-6)
+                return false;
+        }
+        return true;
+    }
+
