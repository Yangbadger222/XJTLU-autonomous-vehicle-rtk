index 0000000..4d6d6ac
--- /dev/null
+++ b/src/EgoPlanner-ROS2/planner/bspline_opt/include/bspline_opt/vehicle_turn_bounds.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <bspline_opt/uniform_bspline.h>
+#include <vector>
+#include <algorithm>
+#include <functional>
+#include <cmath>
+
+namespace ego_planner {
+// Conservative polynomial bounds for each cubic B-spline span. A fixed
+// sampled grid cannot rule out a yaw-rate/curvature spike between samples.
+inline bool certifyVehicleTurnBounds(UniformBspline spline, double curvature_limit,
+    double yaw_limit, double yaw_accel_limit, double yaw_decel_limit) {
+  if (!(curvature_limit>0 && yaw_limit>0 && yaw_accel_limit>0 && yaw_decel_limit>0)) return false;
+  auto velocity=spline.getDerivative(), acceleration=velocity.getDerivative();
+  auto jerk=acceleration.getDerivative();
+  auto choose=[](int n,int k) { double value=1.; for(int i=1;i<=k;++i)value*=double(n-i+1)/i;return value; };
+  auto product=[&](const std::vector<double>& a,const std::vector<double>& b) {
+    const int m=a.size()-1,n=b.size()-1;std::vector<double> result(m+n+1,0.);
+    for(int i=0;i<=m;++i)for(int j=0;j<=n;++j)
+      result[i+j]+=a[i]*b[j]*choose(m,i)*choose(n,j)/choose(m+n,i+j);
+    return result;
+  };
+  auto cross=[](const Eigen::Vector2d& a,const Eigen::Vector2d& b) {return a.x()*b.y()-a.y()*b.x();};
+  std::function<bool(double,double,int)> interval;
+  interval=[&](double begin,double end,int depth) {
+    const double dt=end-begin;
+    const Eigen::Vector2d v0=velocity.evaluateDeBoorT(begin).head<2>(),v2=velocity.evaluateDeBoorT(end).head<2>();
+    const Eigen::Vector2d a0=acceleration.evaluateDeBoorT(begin).head<2>(),a1=acceleration.evaluateDeBoorT(end).head<2>();
+    const Eigen::Vector2d v1=v0+.5*dt*a0,j=jerk.evaluateDeBoorT(.5*(begin+end)).head<2>();
+    if (!v0.allFinite() || !v1.allFinite() || !v2.allFinite() || !a0.allFinite() || !a1.allFinite() || !j.allFinite()) return false;
+    const std::vector<Eigen::Vector2d> vectors={v0,v1,v2,a0,a1,j};
+    auto reference=*std::max_element(vectors.begin(),vectors.end(),[](const auto& a,const auto& b){return a.squaredNorm()<b.squaredNorm();});
+    bool collinear=true;
+    for (const auto& vector:vectors) if(vector.norm()>1e-12 &&
+        std::abs(cross(vector,reference))>1e-10*vector.norm()*reference.norm())collinear=false;
+    if(collinear) {
+      const auto velocity_axis=*std::max_element(vectors.begin(),vectors.begin()+3,
+          [](const auto& a,const auto& b){return a.squaredNorm()<b.squaredNorm();});
+      if(v0.dot(velocity_axis)>=-1e-12 && v1.dot(velocity_axis)>=-1e-12 && v2.dot(velocity_axis)>=-1e-12)return true;
+      // Opposing derivative controls cannot certify forward-only execution.
+    }
+    std::vector<double> vx={v0.x(),v1.x(),v2.x()},vy={v0.y(),v1.y(),v2.y()};
+    auto axis_lower=[](const std::vector<double>& values) {
+      const auto extrema=std::minmax_element(values.begin(),values.end());
+      return *extrema.first>0?*extrema.first:*extrema.second<0?-*extrema.second:0.;
+    };
+    const double lower=std::hypot(axis_lower(vx),axis_lower(vy));
+    const std::vector<double> numerator={cross(v0,a0),(2*cross(v1,a0)+cross(v0,a1))/3.,
+      (cross(v2,a0)+2*cross(v1,a1))/3.,cross(v2,a1)};
+    double largest=0;for(double value:numerator)largest=std::max(largest,std::abs(value));
+    // Exact collinear spans have no turn, including their stopped endpoint.
+    // The tolerance only covers machine roundoff relative to control scales.
+    const double scale=std::max({v0.norm(),v1.norm(),v2.norm()})*std::max(a0.norm(),a1.norm());
+
+    if (lower>1e-9) {
+      auto d=product(vx,vx),dy=product(vy,vy);for(size_t i=0;i<d.size();++i)d[i]+=dy[i];
+      std::vector<double> va={(v0.dot(a0)),(2*v1.dot(a0)+v0.dot(a1))/3.,
+        (v2.dot(a0)+2*v1.dot(a1))/3.,v2.dot(a1)};
+      auto first=product({cross(v0,j),cross(v1,j),cross(v2,j)},d);
+      auto second=product(numerator,va);
+      double high=0,low=0;
+      for(size_t i=0;i<first.size();++i) {const double value=first[i]-2*second[i];high=std::max(high,value);low=std::min(low,value);}
+      const double square=lower*lower;
+      if (largest/square<=yaw_limit && largest/(square*lower)<=curvature_limit &&
+          high/(square*square)<=yaw_accel_limit && -low/(square*square)<=yaw_decel_limit) return true;
+    }
+    if(depth>=16 || dt<=1e-4)return false; // Uncertified intervals stay rejected.
+    const double middle=.5*(begin+end);
+    return interval(begin,middle,depth+1) && interval(middle,end,depth+1);
+  };
+  const double duration=spline.getTimeSum();
+  std::vector<double> boundaries={0.,duration};
+  for (double knot : spline.getKnot()) if(knot>0 && knot<duration)boundaries.push_back(knot);
+  std::sort(boundaries.begin(),boundaries.end());
+  boundaries.erase(std::unique(boundaries.begin(),boundaries.end()),boundaries.end());
+  for(size_t i=1;i<boundaries.size();++i)if(!interval(boundaries[i-1],boundaries[i],0))return false;
+  return true;
+}
+}
