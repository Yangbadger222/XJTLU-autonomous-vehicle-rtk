diff --git a/src/EgoPlanner-ROS2/src/research_tf_guard.cpp b/src/EgoPlanner-ROS2/src/research_tf_guard.cpp
new file mode 100644
index 0000000..49a77a4
--- /dev/null
+++ b/src/EgoPlanner-ROS2/src/research_tf_guard.cpp
@@ -0,0 +1,59 @@
+// Vehicle adaptation: Humble rclpy does not expose per-message publisher GID.
+// This native boundary checks ownership per TF child before command permission.
+#include <rclcpp/rclcpp.hpp>
+#include <tf2_msgs/msg/tf_message.hpp>
+#include <std_msgs/msg/bool.hpp>
+#include <research_interfaces/vehicle_parameter_lock.hpp>
+#include <unordered_map>
+#include <array>
+#include <cmath>
+#include <sstream>
+
+class ResearchTfGuard : public rclcpp::Node {
+  struct Seen { rclcpp::Time acquisition; std::chrono::steady_clock::time_point received; bool valid; };
+  std::unordered_map<std::string,std::unordered_map<std::string,Seen>> owners_;
+  rclcpp::Subscription<tf2_msgs::msg::TFMessage>::SharedPtr input_;
+  rclcpp::Subscription<tf2_msgs::msg::TFMessage>::SharedPtr static_input_;
+  bool protected_static_edge_=false;
+  rclcpp::Publisher<std_msgs::msg::Bool>::SharedPtr output_;
+  rclcpp::TimerBase::SharedPtr timer_;
+public:
+  ResearchTfGuard() : Node("research_tf_integrity_guard") {
+    output_=create_publisher<std_msgs::msg::Bool>("/research/tf_integrity",10);
+    static_input_=create_subscription<tf2_msgs::msg::TFMessage>("/tf_static",rclcpp::QoS(100).reliable().transient_local(),
+      [this](tf2_msgs::msg::TFMessage::ConstSharedPtr message) {
+        for(const auto& t:message->transforms)
+          if(t.child_frame_id=="odom" || t.child_frame_id=="base_footprint")protected_static_edge_=true;
+      });
+    input_=create_subscription<tf2_msgs::msg::TFMessage>("/tf",rclcpp::SensorDataQoS(),
+      [this](tf2_msgs::msg::TFMessage::ConstSharedPtr message, const rclcpp::MessageInfo& info) {
+        const auto& gid=info.get_rmw_message_info().publisher_gid;
+        std::string key(reinterpret_cast<const char*>(gid.data),RMW_GID_STORAGE_SIZE);
+        for (const auto& t : message->transforms) {
+          if (t.child_frame_id!="odom" && t.child_frame_id!="base_footprint") continue;
+          const auto& q=t.transform.rotation; const auto& p=t.transform.translation;
+          const double norm=q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w;
+          const bool valid=t.header.frame_id==(t.child_frame_id=="odom"?"map":"odom") &&
+            std::isfinite(norm) && std::abs(norm-1.)<1e-5 &&
+            std::isfinite(p.x) && std::isfinite(p.y) && std::isfinite(p.z);
+          owners_[t.child_frame_id].insert_or_assign(key,Seen{rclcpp::Time(t.header.stamp),std::chrono::steady_clock::now(),valid});
+        }
+      });
+    timer_=create_wall_timer(std::chrono::milliseconds(50),[this]() {
+      bool valid=!protected_static_edge_; const auto receipt=std::chrono::steady_clock::now();
+      for (const std::string child : {"odom","base_footprint"}) {
+        size_t fresh=0;
+        for (const auto& item : owners_[child]) {
+          const auto& entry=item.second;
+          if (std::chrono::duration<double>(receipt-entry.received).count() > .20) continue;
+          const double age=(now()-entry.acquisition).seconds();
+          ++fresh;
+          valid=valid && entry.valid && entry.acquisition.nanoseconds()>0 && age>=-.10 && age<=.20;
+        }
+        valid=valid && fresh==1;
+      }
+      std_msgs::msg::Bool output; output.data=valid; output_->publish(output);
+    });
+  }
+};
+int main(int argc,char** argv) { rclcpp::init(argc,argv); rclcpp::spin(std::make_shared<ResearchTfGuard>()); rclcpp::shutdown(); }
