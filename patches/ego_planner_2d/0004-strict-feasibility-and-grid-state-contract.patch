+void sampledVehicleTurnCost(const Eigen::MatrixXd& q, double ts,
+    double limit, bool curvature, double& cost, Eigen::MatrixXd& gradient) {
+  cost=0.;gradient.setZero(2,q.cols());
+  if (!(limit>0. && ts>0.)) return;
+  const double exponent=curvature?1.5:1.;
+  const double weight=(curvature?1.:.1)/6.;
+  for(int span=0;span+3<q.cols();++span)
