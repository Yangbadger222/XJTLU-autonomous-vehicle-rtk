+bool TrajectoryAndObstaclesPublisher::stationary_heading_recovery()
+{
+  // Candidate queries must return a complete route to their requested pose;
+  // a preparatory rotation alone cannot assert that route is reachable.
+  if(query_active_ || !enable_stationary_heading_recovery_ || road_reference_.empty() ||
+     stationary_since_.nanoseconds()<=0 || (previous_odom_stamp_-stationary_since_).seconds()<research_vehicle_lock::stopped_confirmation_s ||
+     vehicle_state_.v>.001 || std::abs(vehicle_state_.w)>.001)return false;
+  const auto& goal=road_reference_.back();
+  const double dx=goal.x-vehicle_state_.x,dy=goal.y-vehicle_state_.y;
+  if(std::hypot(dx,dy)<.05)return false;
+  const double delta=angle_delta(std::atan2(dy,dx),vehicle_state_.z);
+  if(std::abs(delta)<.02 || !ego_planner_->isInflatedPositionFree(vehicle_state_.x,vehicle_state_.y))return false;
+  // Every rotation angle fits in the locked footprint's circumscribed disk.
+  // The current grid already inflates that disk; UNKNOWN cells are obstacles.
+  // Quintic yaw has |s'|<=1.875 and |s''|<=5.774. Keep half the physical
+  // yaw/alpha envelope for feedback, without changing the original limits.
+  double duration=std::max({1.,1.875*std::abs(delta)/(.5*max_yaw_rate_rps_),
+    std::sqrt(5.774*std::abs(delta)/(.5*std::min(max_yaw_accel_rps2_,max_yaw_decel_rps2_)))});
+  duration=std::ceil(duration/kSamplePeriod)*kSamplePeriod;
+  research_interfaces::msg::TimedTrajectory2D message;
+  message.header.stamp=to_builtin_time(now());message.header.frame_id="odom";
+  message.generated_at=message.header.stamp;
+  message.valid_until=to_builtin_time(now()+rclcpp::Duration::from_seconds(kTrajectoryValidity));
+  message.trajectory_id="vehicle-heading-recovery-"+std::to_string(++trajectory_id_);
+  message.map_version=map_version_;message.status=message.STATUS_OK;
+  for(int index=0;index<=int(std::round((duration+.5)/kSamplePeriod));++index) {
+    const double t=index*kSamplePeriod,u=std::min(1.,t/duration);
+    const double s=10*u*u*u-15*u*u*u*u+6*u*u*u*u*u;
+    const double ds=30*u*u-60*u*u*u+30*u*u*u*u;
+    const double dds=60*u-180*u*u+120*u*u*u;
+    research_interfaces::msg::TimedTrajectoryPoint2D point;
+    point.motion_mode=point.ROTATE_IN_PLACE;point.t=t;
+    point.x=vehicle_state_.x;point.y=vehicle_state_.y;
+    point.yaw=vehicle_state_.z+delta*s;point.w=delta*ds/duration;point.alpha=delta*dds/(duration*duration);
+    message.points.push_back(point);
+  }
+  executable_cache_=message;executable_cache_valid_=true;
+  executable_goal_=Eigen::Vector2d(goal.x,goal.y);
+  trajectory_publisher_->publish(message);
+  return true;
+}
