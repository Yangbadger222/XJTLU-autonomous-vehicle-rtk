diff --git a/src/super_lio/include/lio/observation_quality.h b/src/super_lio/include/lio/observation_quality.h
new file mode 100644
index 0000000..f6f53dd
--- /dev/null
+++ b/src/super_lio/include/lio/observation_quality.h
@@ -0,0 +1,93 @@
+#pragma once
+#include <Eigen/Core>
+#include <Eigen/Eigenvalues>
+#include <Eigen/Cholesky>
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+namespace LI2Sup {
+// Source-derived: vehicle IESKF threshold, fixed-extrinsic initial covariance,
+// and minimum accepted features. These are not configurable relaxed defaults.
+inline constexpr double kLegacyInformationThreshold = 75.0;
+inline constexpr double kFixedExtrinsicInformation = 1.0 / 0.00001;
+inline constexpr int kMinimumObservedFeatures = 50;
+
+struct ObservationQuality {
+  bool valid = false;
+  bool eligible = false;
+  int iterations = 0;
+  int effective_points = 0;
+  double min_information = 0.0;
+  double legacy_lower_bound = 0.0;
+  std::string reason = "not_observed";
+};
+
+inline ObservationQuality assessObservation(const Eigen::Matrix<double, 6, 6>& information, int count) {
+  ObservationQuality quality;
+  quality.effective_points = count;
+  if (count < kMinimumObservedFeatures) {
+    quality.reason = "insufficient_matched_features";
+    return quality;
+  }
+  if (!information.allFinite()) {
+    quality.reason = "nonfinite_observation_information";
+    return quality;
+  }
+  const auto symmetric = (0.5 * (information + information.transpose())).eval();
+  Eigen::SelfAdjointEigenSolver<Eigen::Matrix<double, 6, 6>> solver(symmetric);
+  if (solver.info() != Eigen::Success || !solver.eigenvalues().allFinite() ||
+      solver.eigenvalues().minCoeff() < -1e-8 * std::max(1.0, information.norm())) {
+    quality.reason = "invalid_observation_information";
+    return quality;
+  }
+  quality.valid = true;
+  quality.iterations = 1;
+  quality.min_information = std::max(0.0, solver.eigenvalues().minCoeff());
+  // With esti_il=false, fixed extrinsics stay independent with P_il=1e-5 I.
+  // For ANY PSD pose prior: lambda_min(diag(Hobs+prior,1e5 I)) >= this bound.
+  // This is stricter than the legacy prior+observation test; not its raw metric.
+  quality.legacy_lower_bound = std::min(quality.min_information, kFixedExtrinsicInformation);
+  quality.eligible = quality.legacy_lower_bound >= kLegacyInformationThreshold;
+  quality.reason = quality.eligible ? "observation_lower_bound_pass" : "observation_lower_bound_below_legacy_threshold";
+  return quality;
+}
+
+inline void accumulateObservationQuality(ObservationQuality& worst, const ObservationQuality& current) {
+  if (!worst.iterations) { worst = current; return; }
+  worst.valid = worst.valid && current.valid;
+  worst.eligible = worst.eligible && current.eligible;
+  worst.iterations += current.iterations;
+  worst.effective_points = std::min(worst.effective_points, current.effective_points);
+  worst.min_information = std::min(worst.min_information, current.min_information);
+  worst.legacy_lower_bound = std::min(worst.legacy_lower_bound, current.legacy_lower_bound);
+  if (!current.eligible) worst.reason = current.reason;
+}
+
+inline Eigen::Matrix<double, 6, 6> poseCovariance(
+    const Eigen::Matrix<double, 18, 18>& covariance, const Eigen::Matrix3d& world_from_imu) {
+  Eigen::Matrix<double, 6, 18> jacobian = Eigen::Matrix<double, 6, 18>::Zero();
+  jacobian.block<3,3>(0,3).setIdentity();
+  jacobian.block<3,3>(3,0) = world_from_imu;  // right rotation error -> world fixed axes
+  return jacobian * covariance * jacobian.transpose();
+}
+
+inline Eigen::Matrix<double, 6, 6> twistCovariance(
+    const Eigen::Matrix<double, 18, 18>& covariance, const Eigen::Matrix3d& world_from_imu,
+    const Eigen::Vector3d& world_velocity, double gyro_sample_variance) {
+  Eigen::Matrix<double, 6, 18> jacobian = Eigen::Matrix<double, 6, 18>::Zero();
+  const Eigen::Vector3d body_velocity = world_from_imu.transpose()*world_velocity;
+  Eigen::Matrix3d skew;
+  skew << 0,-body_velocity.z(),body_velocity.y(),body_velocity.z(),0,-body_velocity.x(),
+          -body_velocity.y(),body_velocity.x(),0;
+  // v_I = R_WI^T v_W; right rotation error contributes [v_I]x dtheta.
+  // Preserve theta/v/bg cross blocks by using the complete native state.
+  jacobian.block<3,3>(0,0) = skew;
+  jacobian.block<3,3>(0,6) = world_from_imu.transpose();
+  jacobian.block<3,3>(3,9) = -Eigen::Matrix3d::Identity();  // omega = measured gyro - bias
+  Eigen::Matrix<double, 6, 6> result = jacobian * covariance * jacobian.transpose();
+  // Conditional native white-noise model; retains state cross blocks.
+  result.block<3,3>(3,3) += gyro_sample_variance * Eigen::Matrix3d::Identity();
+  return result;
+}
+}  // namespace LI2Sup
