<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>1.0.0</version>
  <description>System bringup launch files, configuration, and runtime helpers</description>
  <maintainer email="Kevinlasnh@outlook.com">FYP Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nmea_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- Active-road research entry dependencies. Legacy packages remain
       available for the original launch files and rollback. -->
  <exec_depend>super_lio</exec_depend>
  <exec_depend>ego_planner</exec_depend>
  <exec_depend>research_interfaces</exec_depend>
  <exec_depend>research_runtime</exec_depend>
  <exec_depend>active_road_mapping</exec_depend>
  <exec_depend>super_lio_vehicle_adapter</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>um982_rtk_driver</exec_depend>
  <exec_depend>gps_waypoint_dispatcher</exec_depend>
  <exec_depend>serial_twistctl</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
