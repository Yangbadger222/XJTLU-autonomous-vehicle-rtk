<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>indoor_navigation_manager</name>
  <version>1.0.0</version>
  <description>Named-destination action manager for indoor Nav2 navigation</description>
  <maintainer email="Kevinlasnh@outlook.com">FYP Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>interface</depend>
  <depend>nav2_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
