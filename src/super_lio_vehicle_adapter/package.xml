<?xml version="1.0"?>
<package format="3">
  <name>super_lio_vehicle_adapter</name>
  <version>0.1.0</version>
  <description>Source-aware Super-LIO navigation reference and measurement-matched conservative health interface.</description>
  <maintainer email="research@xjtlu.invalid">XJTLU research</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
